{
  "include": [
    "./vite.config.ts",
    "./build/*.ts",
    "./build/**/*.ts",
    "./types/env.d.ts"
  ],
  "exclude": [
    "./build/prepare-local-files/*"
  ],
  "compilerOptions": {
    "declaration": false,
    "lib": [
      "ES2021",
      "ES2022",
      "ES2023",
      "ES2024",
      "ESNext"
    ],
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipDefaultLibCheck": true,
    "types": [
      "node"
    ]
  }
}
